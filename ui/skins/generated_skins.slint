import { BaseSkin } from "base-skin.slint";
import { CompactVinylPlayer } from "compact-vinyl-player/compact-vinyl-player.slint";
import { RealisticVinylPlayer } from "realistic-vinyl-player/realistic-vinyl-player.slint";
import { VinylCard } from "vinyl-card/vinyl-card.slint";

export struct SkinConfig {
width: length,
height: length,
border_radius: length,
border_top_left_radius: length,
border_top_right_radius: length,
border_bottom_left_radius: length,
border_bottom_right_radius: length,
transparent_background: bool,
}

export global SkinRegistry {
pure public function get_config(skin_name: string) -> SkinConfig {
        if (skin_name.to-lowercase() == "compact-vinyl-player") {
return {
width: 300px,
height: 420px,
border_radius: 0px,
border_top_left_radius: 12px,
border_top_right_radius: 0px,
border_bottom_left_radius: 0px,
border_bottom_right_radius: 0px,
transparent_background: true,
};
}
        if (skin_name.to-lowercase() == "realistic-vinyl-player") {
return {
width: 450px,
height: 400px,
border_radius: 12px,
border_top_left_radius: 0px,
border_top_right_radius: 0px,
border_bottom_left_radius: 0px,
border_bottom_right_radius: 0px,
transparent_background: true,
};
}
        if (skin_name.to-lowercase() == "vinyl-card") {
return {
width: 500px,
height: 150px,
border_radius: 16px,
border_top_left_radius: 0px,
border_top_right_radius: 0px,
border_bottom_left_radius: 0px,
border_bottom_right_radius: 0px,
transparent_background: true,
};
}
        return {
width: 200px,
height: 200px,
border_radius: 0px,
border_top_left_radius: 0px,
border_top_right_radius: 0px,
border_bottom_left_radius: 0px,
border_bottom_right_radius: 0px,
transparent_background: false,
};
}
}

export component SkinHost inherits BaseSkin {
in property <string> skin;

    if (root.skin.to-lowercase() == "compact-vinyl-player"): CompactVinylPlayer {
media_data: root.media_data;
position_secs: root.position_secs;
animation_state: root.animation_state;
play_pause => { root.play_pause() }
next => { root.next() }
prev => { root.prev() }
seek(val) => { root.seek(val) }
visualizer_toggled(active) => { root.visualizer_toggled(active) }
}
    if (root.skin.to-lowercase() == "realistic-vinyl-player"): RealisticVinylPlayer {
media_data: root.media_data;
position_secs: root.position_secs;
animation_state: root.animation_state;
play_pause => { root.play_pause() }
next => { root.next() }
prev => { root.prev() }
seek(val) => { root.seek(val) }
visualizer_toggled(active) => { root.visualizer_toggled(active) }
}
    if (root.skin.to-lowercase() == "vinyl-card"): VinylCard {
media_data: root.media_data;
position_secs: root.position_secs;
animation_state: root.animation_state;
play_pause => { root.play_pause() }
next => { root.next() }
prev => { root.prev() }
seek(val) => { root.seek(val) }
visualizer_toggled(active) => { root.visualizer_toggled(active) }
}
}
